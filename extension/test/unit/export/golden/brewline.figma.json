{
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#1F5E4B"
    },
    "primary-2": {
      "$type": "color",
      "$value": "#2E7A63"
    },
    "accent": {
      "$type": "color",
      "$value": "#E0763A"
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFDF8"
    },
    "surface-2": {
      "$type": "color",
      "$value": "#F3EEE4"
    },
    "text": {
      "$type": "color",
      "$value": "#1B1A17"
    },
    "text-2": {
      "$type": "color",
      "$value": "#5C574E"
    },
    "border": {
      "$type": "color",
      "$value": "#E4DDD0"
    },
    "accent-aa": {
      "$type": "color",
      "$value": "#B4501A"
    }
  },
  "font": {
    "body": {
      "$type": "string",
      "$value": "\"DM Sans\", sans-serif"
    },
    "heading": {
      "$type": "string",
      "$value": "Fraunces, serif"
    }
  },
  "text": {
    "display": {
      "size": {
        "$type": "number",
        "$value": 48
      },
      "line-height": {
        "$type": "number",
        "$value": 56
      },
      "weight": {
        "$type": "number",
        "$value": 600
      }
    },
    "h1": {
      "size": {
        "$type": "number",
        "$value": 24
      },
      "line-height": {
        "$type": "number",
        "$value": 32
      },
      "weight": {
        "$type": "number",
        "$value": 600
      }
    },
    "body": {
      "size": {
        "$type": "number",
        "$value": 16
      },
      "line-height": {
        "$type": "number",
        "$value": 26
      },
      "weight": {
        "$type": "number",
        "$value": 400
      }
    },
    "small": {
      "size": {
        "$type": "number",
        "$value": 13
      },
      "line-height": {
        "$type": "number",
        "$value": 18
      },
      "weight": {
        "$type": "number",
        "$value": 500
      }
    }
  },
  "space": {
    "1": {
      "$type": "number",
      "$value": 4
    },
    "2": {
      "$type": "number",
      "$value": 8
    },
    "3": {
      "$type": "number",
      "$value": 12
    },
    "4": {
      "$type": "number",
      "$value": 16
    },
    "5": {
      "$type": "number",
      "$value": 24
    },
    "6": {
      "$type": "number",
      "$value": 32
    },
    "7": {
      "$type": "number",
      "$value": 48
    }
  },
  "radius": {
    "sm": {
      "$type": "number",
      "$value": 4
    },
    "md": {
      "$type": "number",
      "$value": 10
    },
    "full": {
      "$type": "number",
      "$value": 9999
    }
  },
  "$extensions": {
    "com.figma": {
      "modes": [
        "Light"
      ]
    },
    "com.vietnamcos.site-to-design-token": {
      "site": "brewline.co",
      "textStyles": [
        {
          "name": "display",
          "fontFamily": "Fraunces",
          "fontWeight": 600,
          "fontSize": 48,
          "lineHeight": 56
        },
        {
          "name": "h1",
          "fontFamily": "DM Sans",
          "fontWeight": 600,
          "fontSize": 24,
          "lineHeight": 32
        },
        {
          "name": "body",
          "fontFamily": "DM Sans",
          "fontWeight": 400,
          "fontSize": 16,
          "lineHeight": 26
        },
        {
          "name": "small",
          "fontFamily": "DM Sans",
          "fontWeight": 500,
          "fontSize": 13,
          "lineHeight": 18
        }
      ],
      "shadowStyles": [
        {
          "name": "sm",
          "layers": [
            {
              "color": "#000000",
              "opacity": 0.5,
              "offsetX": 0,
              "offsetY": 1,
              "blur": 2,
              "spread": 0
            }
          ]
        },
        {
          "name": "md",
          "layers": [
            {
              "color": "#000000",
              "opacity": 0.6,
              "offsetX": 0,
              "offsetY": 6,
              "blur": 16,
              "spread": 0
            }
          ]
        }
      ]
    }
  }
}
