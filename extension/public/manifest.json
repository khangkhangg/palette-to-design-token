{
  "manifest_version": 3,
  "name": "Site to Design Token",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "description": "Turn any website into design tokens: colours, type, spacing, radius, shadows and contrast.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site to Design Token",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": { "matches": ["https://vietnamcos.com/palette/*", "https://www.vietnamcos.com/palette/*"] },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
